#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
ROOT_DIR="$(dirname "${SCRIPT_DIR}")"

DASHBOARD_SCRIPT=""
for candidate in \
    "${SCRIPT_DIR}/awcc-lux-dashboard.py" \
    "${HOME}/.local/bin/awcc-lux-dashboard.py" \
    "/usr/local/bin/awcc-lux-dashboard.py" \
    "/usr/bin/awcc-lux-dashboard.py"; do
    if [[ -f "$candidate" ]]; then
        DASHBOARD_SCRIPT="$candidate"
        break
    fi
done

AWCCCTL_BIN=""
for candidate in \
    "${ROOT_DIR}/target/release/awccctl" \
    "${HOME}/.local/bin/awccctl" \
    "/usr/local/bin/awccctl" \
    "/usr/bin/awccctl"; do
    if [[ -x "$candidate" ]]; then
        AWCCCTL_BIN="$candidate"
        break
    fi
done

if [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]]; then
    echo "AWCC Linux: Hardware Performance & Thermal Telemetry Tracker"
    echo "Usage: awcc-track [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --once               Single-shot telemetry readout"
    echo "  --json               JSON-formatted real-time telemetry stream"
    echo "  --cli                Terminal matrix tracking mode (via awccctl)"
    echo "  --theme <name>       Color grading theme (cryo, cyberpunk, darkcore, solar, matrix, vaporwave)"
    echo "  -h, --help           Show this help message and exit"
    exit 0
fi

# If JSON streaming or CLI mode is requested, use awccctl
if [[ "${1:-}" == "--json" ]] || [[ "${2:-}" == "--json" ]] || [[ "${1:-}" == "--cli" ]] || [[ "${1:-}" == "--once" ]]; then
    if [[ -n "$AWCCCTL_BIN" ]]; then
        exec "$AWCCCTL_BIN" track "$@"
    else
        echo "[-] Error: awccctl binary not found for CLI/JSON tracking." >&2
        exit 1
    fi
fi

# If live terminal cockpit is available, launch it
if [[ -n "$DASHBOARD_SCRIPT" ]]; then
    exec python3 "$DASHBOARD_SCRIPT" "$@"
elif [[ -n "$AWCCCTL_BIN" ]]; then
    exec "$AWCCCTL_BIN" track "$@"
else
    echo "[-] Error: Neither awcc-lux-dashboard.py nor awccctl found." >&2
    exit 1
fi
